class Solution {
    public int maxProfit(int[] prices) {
        int n=prices.length;
        int i=0,j=i+1;
        int profit=-1;
        while(i<=j && j<n){
            if(prices[i]<=prices[j]){
                if((prices[j]-prices[i])>profit){
                    profit=prices[j]-prices[i];
                }
                j++;   
            }
            else{
                i++;
            }
        }
        if(profit==-1) return 0;
        return profit;    
    }
}
