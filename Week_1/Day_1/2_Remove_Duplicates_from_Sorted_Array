class Solution {
    public int removeDuplicates(int[] nums) {
        int n= nums.length;
        int[] ans = new int[nums.length];
        int i=0,j=0,k=0;
        while(i<n){
            if(i==n || j==n){
                ans[k++]=nums[i];
                break;
            }
            if(nums[i]==nums[j]){
                j++;
            }
            else{
                ans[k++]=nums[i];
                i=j;
            }
        }
        for(i=0;i<n;i++){
            nums[i]=ans[i];
        }
        return k; 
    }
}
